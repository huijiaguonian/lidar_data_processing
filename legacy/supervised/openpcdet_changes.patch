+def transform_points_coordinates(points, pose):
+    """
+    Robust function to transform points coordinates between coordinate systems
+    Handles different versions of pandaset and different pose formats
+    """
+    try:
+        # Try new version function name first
+        if hasattr(ps.geometry, 'transform_points'):
+            return ps.geometry.transform_points(points, pose)
+        # Try alternative function name
+        elif hasattr(ps.geometry, 'apply_pose'):
+            return ps.geometry.apply_pose(points, pose)
+        else:
+            # Manual implementation as fallback
+            if isinstance(pose, dict):
+                # Extract rotation matrix and translation from pose dict
+                heading = pose['heading']
+                w, x, y, z = heading['w'], heading['x'], heading['y'], heading['z']
+
+                # Convert quaternion to rotation matrix
+                rotation = np.array([
+                    [1 - 2*y*y - 2*z*z, 2*x*y - 2*z*w, 2*x*z + 2*y*w],
+                    [2*x*y + 2*z*w, 1 - 2*x*x - 2*z*z, 2*y*z - 2*x*w],
+                    [2*x*z - 2*y*w, 2*y*z + 2*x*w, 1 - 2*x*x - 2*y*y]
+                ])
+
+                translation = np.array([
+                    pose['position']['x'],
+                    pose['position']['y'],
+                    pose['position']['z']
+                ])
+            else:
+                # Assume pose is a 4x4 transformation matrix
+                rotation = pose[:3, :3]
+                translation = pose[:3, 3]
+
+            # Apply transformation: world_points = R @ ego_points + T
+            transformed_points = np.dot(points, rotation.T) + translation
+            return transformed_points
+    except Exception as e:
+        print(f"Coordinate transformation failed: {e}")
+        # Return original points if transformation fails
+        return points
+
